["Tempeh","19 g"],["Firm tofu","15 g"],["Cottage cheese","12 g"],["Skyr","11 g"],["Edamame","11 g"],
["Greek yoghurt 0%","10 g"],["Lentils, cooked","9 g"],["Chickpeas, cooked","9 g"],["Eggs","6 g each"],
["Whey powder","24 g a scoop"],["Milk","3.4 g per 100 ml"]];
