  '<div class="panel"><h2>Protein per 100 g cooked</h2><table>'+
    PROT.map(function(p){return '<tr><td>'+esc(p[0])+'</td><td class="n">'+p[1]+'</td></tr>';}).join("")+
    '</table><div class="note">Aim for 30 to 40 g a meal across four meals. Spreading it out beats loading it all '+
    'into dinner.</div></div>'+

  '<div class="panel"><h2>A day that hits the targets</h2><table>'+
    DAY.map(function(r){return '<tr><td style="width:52px;color:var(--soft)">'+esc(r[0])+'</td><td>'+esc(r[1])+
      '</td><td class="n" style="white-space:nowrap">'+r[2]+'<br><span class="tiny">'+r[3]+'</span></td></tr>';}).join("")+
